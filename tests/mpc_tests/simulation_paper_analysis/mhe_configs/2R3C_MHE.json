{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*Prad + Ai*(phi_s/Ci)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "dT": "rad_219*(dTdim - dT)/tau + (1 - rad_219)*(dTpeak - dT)/tau"
        },
        "alg": {
            "Prad": "Prad - dT*rad_219*rad_flo_nom*cp_water",
            "dTdim": "dTdim - (dT_b - dT_a*(Ta - Ta_dim))",
            "dTpeak": "dTpeak - (dTpeak_b - dT_a*(Ta - Ta_dim))"
        },
        "w": {
            "v1": "Ti - y1",
            "v2": "Prad - y3"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "dT_b",
            "dT_a",
            "Ta_dim", 
            "rad_flo_nom",
            "dTpeak_b",
            "tau", 
            "cp_water"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
            "Ta",
            "phi_s",
            "cost"
        ],
        "x": [
            "Ti",
            "Te",
            "dT"
        ],
        "z": [
            "Prad",
            "dTdim",
            "dTpeak"
        ],
        "y": [
            ["y1", "Ti"],
            ["y3", "Prad"]
        ]
    },
    "objective": "R[0,0]*dot(v1, v1) + R[1,1]*dot(v2, v2) + Q[0,0]*dot(s1, s1) + Q[1,1]*dot(s2, s2) + Q[2,2]*dot(s3, s3)",
    "N": 96,
    "dt": 900,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 2,
        "ipopt.max_iter": 1000,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
