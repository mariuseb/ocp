{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (Ta - Ti)/(Ria*Ci) + Ai*(phi_s/Ci) + rho_int*((int_con+int_lat+int_rad)/Ci) + (1/Ci)*Prad_to_env",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "Trad": "P_to_rad/Crad - Prad_to_env/Crad",
            "Tret": "(rad_flo*a1*(Trad - Tret))/(Rrr*Cret)"
        },
        "alg": {
            "Prad_to_env": "Prad_to_env - (Trad - Ti)/Rirad",
            "P_to_rad": "P_to_rad - rad_flo*cp_water*(dh_Tsup - Trad)",
            "Prad": "Prad - rad_flo*cp_water*eta_hex_rad*(dh_Tsup - Tret)",
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_val, n1, 1E-6)"
        },
        "p": [
            "Rie",
            "Rea",
            "Ria",
            "Rirad",
            "Rrr",
            "Rsr",
            "rho_int",
            "Ci",
            "Ce",
            "Crad",
            "Cret",
            "Csup_nom",
            "Ai",
            "cp_water",
            "cp_air",
            "alpha_vent1",
            "alpha_vent2",
            "Tret_offset",
            "dh_Tsup",
            "a1",
            "rad_flo_nom",
            "n1",
            "eta_hex_rad"

        ],
        "u": [
            "rad_val"
        ],
        "r": [
            "Ta",
            "phi_s",
            "int_con",
            "int_lat",
            "int_rad"
        ],
        "x": [
            "Ti",
            "Te",
            "Trad",
            "Tret"
        ],
        "z": [
            "Prad_to_env",
            "P_to_rad",
            "Prad",
            "rad_flo"
        ]
    },
    "bounds": {
        "u": {
            "lbu": [0],
            "ubu": [1]
        },
        "x": {
            "lbx": [280,280,280,280],
            "ubx": [340,340,340,340]
        },
        "z": {
            "lbz": [-1E5,-1E5,-1E5,0],
            "ubz": [1E6,1E6,1E6,20]
        }
    },
    "objective": "dot(P_to_rad, P_to_rad)  + 1E3*dot(sl, sl)",
    "N": 24,
    "dt": 900,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 300,
        "ipopt.max_iter": 3000,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
