{
    "model": {
        "ode": {
            "Trad_HVAC": "P_to_rad_act/Crad + (Ti - Trad_HVAC)/(Rirad*Crad)",
            "Tret": "(rad_flo*a1*(Trad_HVAC - Tret))/(Rrr*Cret)"
        },
        "alg": {
            "Prad": "Prad - rad_flo*cp_water*eta_hex_rad*(dh_Tsup - Tret)",
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_val, n1, 1E-6)",
            "P_to_rad_act": "P_to_rad_act - rad_flo*cp_water*(dh_Tsup - Trad_HVAC)"
        },
        "p": [
            "cp_water",
            "eta_hex_ahu",
            "eta_hex_rad",
            "m_flow_air_nom",
            "m_flow_air_nom_ext",
            "cp_air",
            "eta_hex1",
            "Trec_off",
            "k",
            "ahu_pump_sup_thres",
            "n",
            "n1",
            "n2",
            "n3",
            "n4",
            "rad_flo_nom",
            "coi_flo_nom_b",
            "coi_flo_nom_a",
            "Tret_coi_b",
            "dh_Tsup",
            "dh_Tsup_off",
            "a",
            "b",
            "c",
            "d",
            "Rirad",
            "Rrr",
            "Rsr",
            "rho_int",
            "Crad",
            "Cret",
            "Csup",
            "Rsup",
            "Csup_off",
            "Rsup_off",
            "Csup_nom",
            "Tret_offset",
            "a1",
            "a2",
            "P_to_rad_MPC_1",
            "P_to_rad_MPC_2"
        ],
        "u": [
            "rad_val"
        ],
        "r": [
            "Ta",
            "phi_s",
            "int_con",
            "int_lat",
            "int_rad",
            "n_occ",
            "Ti",
            "Trad_ENV"
        ],
        "x": [
            "Trad_HVAC",
            "Tret"
        ],
        "z": [
            "Prad",
            "rad_flo",
            "P_to_rad_act"
        ]
    },
    "bounds": {
        "u": {
            "lbu": [0],
            "ubu": [1]
        },
        "x": {
            "lbx": [280,280],
            "ubx": [340,340]
        },
        "z": {
            "lbz": [-1E5,0,-1E5],
            "ubz": [1E7,20,1E7]
        }
    },
    "objective": "dot(Trad_ENV - Trad_HVAC, Trad_ENV - Trad_HVAC)  + 1E3*dot(sl, sl)",
    "N": 16,
    "dt": 60,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 15,
        "ipopt.max_iter": 3000,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
