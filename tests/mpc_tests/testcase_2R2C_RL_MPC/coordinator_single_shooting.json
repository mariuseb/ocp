{
    "days": 2,
    "sampling_time": "15min",
    "controller": {
        "timezone": "Europe/Oslo",
        "temp_conv": 273.15,
        "sampling_time": "15min",
        "mpc_config_file": "mpc_configs/2R2C_MPC_single_shooting.json",
        "scaling": {
            "x_nom": [12, 12],
            "x_nom_b": [289.15, 289.15],
