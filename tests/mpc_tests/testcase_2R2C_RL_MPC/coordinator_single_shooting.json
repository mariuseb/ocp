                "x": [
                    "Ti",
                    "Te"
                ],
                "y": [
                    ["y1", "Ti"],
                    ["y2", "Te"]
                ]
            },
            "parameters": [1e-3, 1e-2, 1E6, 1E7],
            "maps": 
            {
                "r" : {"Ta": "TDryBul",
                "Ti_lb": "LowerSetp[1]",
                "Ti_ub": "UpperSetp[1]",
                "cost": "PriceElectricPowerHighlyDynamic"
                },
                "u" : {
                    "phi_h": "oveAct"
                },
                "y":  {
