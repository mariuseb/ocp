{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (Ta - Ti)/(Ria*Ci) + Ai*(phi_s/Ci) + Prad_to_env/Ci",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)"
        },
        "alg": {
            "Prad_to_env": "Prad_to_env - (Trad - Ti)/Rirad"
        },
        "p": [
            "Rie",
            "Rea",
            "Ria",
            "Rirad",
            "Ci",
            "Ce",
            "Crad",
            "Ai",
            "n",
            "rad_flo_nom",
            "cp_water",
            "Csup",
            "Rsup",
            "Riret",
            "Risup",
            "Cret",
            "Tsup_offset",
            "Tret_offset",
            "Tset_sup_b",
            "Tset_sup_a",
            "Ta_dim",
            "Trad_zero"

        ],
        "u": [
            "Trad"
        ],
        "r": [
            "Ta",
            "phi_s"
        ],
        "x": [
            "Ti",
            "Te"
        ],
        "z": [
          "Prad_to_env"
        ]
    },
    "ocp": {
        "h": 
        [
            "0 == Trad[0] - Trad_zero"        
        ]
    },
    "bounds": {
        "u": {
            "lbu": [280],
            "ubu": [340]
        },
        "x": {
            "lbx": [280,280],
            "ubx": [340,340]
        },
        "z": {
            "lbz": [-100],
            "ubz": [1E4]
        }
    },
    "objective": "dot(Prad_to_env, Prad_to_env) + 1E3*dot(sl, sl)",
    "N": 96,
    "dt": 900,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 300,
        "ipopt.max_iter": 3000,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
