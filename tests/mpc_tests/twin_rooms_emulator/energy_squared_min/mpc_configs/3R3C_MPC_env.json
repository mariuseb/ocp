{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (Ta - Ti)/(Ria*Ci) + Ai*(phi_s/Ci) + Prad_to_env/Ci",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "Trad": "P_to_rad/Crad - Prad_to_env/Crad"
        },
        "alg": {
            "P_to_rad": "P_to_rad - (Tsup - Trad)*cp_water*rad_flo",
            "Prad_to_env": "Prad_to_env - (Trad - Ti)/Rirad"
        },
        "p": [
            "Rie",
            "Rea",
            "Ria",
            "Rirad",
            "Ci",
            "Ce",
            "Crad",
            "Ai",
            "n",
            "rad_flo_nom",
            "cp_water",
            "Csup",
            "Rsup",
            "Riret",
            "Risup",
            "Cret",
            "Tsup_offset",
            "Tret_offset",
            "Tset_sup_b",
            "Tset_sup_a",
            "Ta_dim"

        ],
        "u": [
            "Tsup",
            "rad_flo"
        ],
        "r": [
            "Ta",
            "phi_s"
        ],
        "x": [
            "Ti",
            "Te",
            "Trad"
        ],
        "z": [
          "P_to_rad",
          "Prad_to_env"
        ]
    },
    "bounds": {
        "u": {
            "lbu": [280,0],
            "ubu": [340,0.15]
        },
        "x": {
            "lbx": [280,280,280],
            "ubx": [340,340,340]
        },
        "z": {
            "lbz": [0,0],
            "ubz": [1E4,1E4]
        }
    },
    "objective": "dot(P_to_rad, P_to_rad) + 1E3*dot(sl, sl)",
    "N": 24,
    "dt": 900,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 300,
        "ipopt.max_iter": 3000,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
