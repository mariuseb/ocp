{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*Prad + Ai*(phi_s/Ci) + alpha_int*(phi_int/Ci) + alpha_vent*cp_air*fan_219*(Tsup_air - Ti)/Ci",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "dT": "(rad_flo/rad_flo_nom)*(dTdim - dT)/tau + (1 - (rad_flo/rad_flo_nom))*(dTpeak - dT)/tau"
        },
        "alg": {
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_219, n, 1E-6)",
            "Prad": "Prad - dT*rad_flo*cp_water",
            "dTdim": "dTdim - (dT_b - dT_a*(Ta - Ta_dim))",
            "dTpeak": "dTpeak - (dTpeak_b - dTpeak_a*(Ta - Ta_dim))"
        },
        "w": {
            "v1": "Ti - y1",
            "v2": "rad_flo - y2",
            "v3": "Prad - y3"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",            
            "alpha_int",
            "alpha_vent",
            "dT_b",
            "dT_a",
            "Ta_dim", 
            "rad_flo_nom",
            "dTpeak_b",
            "dTpeak_a",
            "tau", 
            "n", 
            "cp_water",
            "cp_air"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
            "Ta",
            "Tsup_air",
            "phi_s",
            "fan_219",
            "phi_int",
            "cost"
        ],
        "x": [
            "Ti",
            "Te",
            "dT"
        ],
        "z": [
            "rad_flo",
            "Prad",
            "dTdim",
            "dTpeak"
        ],
        "y": [
            ["y1", "Ti"],
            ["y2", "rad_flo"],
            ["y3", "Prad"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [280,280,0],
            "ubx": [340,340,30]
        },
        "z": {
            "lbz": [0,0,0,0],
            "ubz": [0.15,1E4,30,30]
        },
        "u": {
            "lbu": [0],
            "ubu": [1]
        }
    },
    "objective": "R[0,0]*dot(v1, v1) + R[1,1]*dot(v2, v2) + R[2,2]*dot(v3, v3) + Q[0,0]*dot(s1, s1) + Q[1,1]*dot(s2, s2) + Q[2,2]*dot(s3, s3)",
    "N": 96,
    "dt": 900,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 200,
        "ipopt.print_level": 0,
        "print_time": 0,
        "ipopt.max_iter": 1000,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
