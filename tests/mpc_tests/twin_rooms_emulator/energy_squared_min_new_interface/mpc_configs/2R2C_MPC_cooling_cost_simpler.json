{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + Ai*(phi_s/Ci) + Prad/Ci - coo_219/Ci + fan_219*1000*(Tsup_set_219 - Ti)/Ci",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "alpha_int",
            "n",
            "Prad_nom"
        ],
        "u": [
            "Prad",
            "coo_219",
            "Tsup_set_219"
        ],
        "r": [
            "Ta",
            "phi_s",
            "phi_int",
            "fan_219",
            "cost"
        ],
        "x": [
            "Ti",
            "Te"
        ]
    },
    "ocp": {
        "h": [
            "0 <= Tsup_set_219 - Ta"
        ]
    },
    "bounds": {
        "u": {
            "lbu": [0,0,250],
            "ubu": [1699.52,5000,292.15]
        },
        "x": {
            "lbx": [280,280],
            "ubx": [340,340]
        }
    },
    "objective": "dot(cost, Prad) + dot(cost, coo_219) + 1E3*dot(sl, sl)",
    "N": 96,
    "delay": 0,
    "dt": 900,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.print_level": 0,
        "ipopt.ma57_pre_alloc": 10, 
        "ipopt.ma57_automatic_scaling": "yes", 
        "ipopt.max_cpu_time": 300,
        "ipopt.max_iter": 3000,
        "print_time": false,
        "ipopt.check_derivatives_for_naninf": "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
