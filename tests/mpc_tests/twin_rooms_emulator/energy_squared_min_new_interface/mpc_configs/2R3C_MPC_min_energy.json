{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*Prad + Ai*(phi_s/Ci) + alpha_int*(phi_int/Ci) + alpha_vent*cp_air*fan_219*(Tsup_air - Ti)/Ci",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "dT": "(rad_flo/rad_flo_nom)*(dTdim - dT)/tau + (1 - (rad_flo/rad_flo_nom))*(dTpeak - dT)/tau"
        },
        "alg": {
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_219, n, 1E-6)",
            "Prad": "Prad - dT*rad_flo*cp_water",
            "dTdim": "dTdim - (dT_b - dT_a*(Ta - Ta_dim))",
            "dTpeak": "dTpeak - (dTpeak_b - dTpeak_a*(Ta - Ta_dim))"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "alpha_int",
            "alpha_vent",
            "dT_b",
            "dT_a",
            "Ta_dim", 
            "rad_flo_nom",
            "dTpeak_b",
            "dTpeak_a",
            "tau", 
            "n", 
            "cp_water",
            "cp_air"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
            "Ta",
            "Tsup_air",
            "phi_s",
            "fan_219",
            "phi_int",
            "cost"
        ],
        "x": [
            "Ti",
            "Te",
            "dT"
        ],
        "z": [
            "rad_flo",
            "Prad",
            "dTdim",
            "dTpeak"
        ]
    },
        "bounds": {
        "x": {
            "lbx": [280,280,0],
            "ubx": [340,340,30]
        },
        "z": {
            "lbz": [0,0,0,0],
            "ubz": [0.15,1E4,30,30]
        },
        "u": {
            "lbu": [0],
            "ubu": [1]
        }
    },
    "N": 12,
    "dt": 900,
    "objective": "ca.sum1(Prad) + 1E3*dot(sl, sl) + 1e1*dot(rad_219[0:10] - rad_219[1:11], rad_219[0:10] - rad_219[1:11])",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.print_level": 0,
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.max_iter" : 1E5
    },
    "codegen": false
}
