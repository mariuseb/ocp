{
    "model": {
        "ode": {
            "E": "(kp/ki)*(Tdev)*heat_mode",
            "aw": "k_aw*(u_val - u_val_cmd)"

        },
        "alg": {
            "u_val_cmd": "u_val - (u_prop + u_int)",
            "u_prop": "u_prop - kp*Tdev",
            "u_val": "u_val - (1/(1 + ca.exp(-u_val_cmd*a + b)))",
            "u_int": "u_int - (E)"
        },
        "w": {
            "v2": "y2 - u_val"
        },
        "p": [
            "kp",
            "ki",
            "ki_off",
            "k_aw",
            "a",
            "b"
        ],
        "u": [
            "Tset",
            "Ti",
            "Tdev",
            "heat_mode"
        ],
        "x": [
            "E",
            "aw"
        ],
        "z": [
            "u_val_cmd",
            "u_prop",
            "u_val",
            "u_int"
        ],
        "r": [
        ],
        "y": [
            ["y2", "u_val"]
        ]
    },
    "ocp": {
        "h": 
        [
        ]
    },
    "bounds": {
        "z": {
            "lbz": [-1,-100,-1,-1e4],
            "ubz": [100,100,100,1e4]
        },
        "x": {
            "lbx": [-1e4,-1e4],
            "ubx": [1e4,1e4]
        }
    },
    "objective": "dot(v2, v2)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
    {
        "name": "IRK",
        "method": "legendre",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma86",
        "ipopt.ma57_pre_alloc": 1,
        "ipopt.max_cpu_time": 200,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
