{
    "model": {
        "ode": {
            "E": "(kp/ki)*sigmoid(Tdev,c,d)*heat_mode - E*(1 - heat_mode)*(kp_off/ki_off)"

        },
        "alg": {
            "u_val_cmd": "u_val_cmd - (kp*Tdev + E)",
            "u_val": "u_val - sigmoid(u_val_cmd, a, b)"
        },
        "w": {
            "v2": "y2 - u_val"
        },
        "p": [
            "kp",
            "ki",
            "ki_off",
            "kp_off",
            "k_aw",
            "a",
            "b",
            "c",
            "d"
        ],
        "u": [
            "Tset",
            "Ti",
            "Tdev",
            "heat_mode"
            
        ],
        "x": [
            "E"
        ],
        "z": [
            "u_val_cmd",
            "u_val"
        ],
        "r": [
        ],
        "y": [
            ["y2", "u_val"]
        ]
    },
    "ocp": {
        "h": 
        [  
        ]
    },
    "bounds": {
        "z": {
            "lbz": [-1,-1e-3],
            "ubz": [100,1.001]
        },
        "x": {
            "lbx": [-2e1],
            "ubx": [2e1]
        }
    },
    "objective": "dot(v2, v2)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
    {
        "name": "IRK",
        "method": "legendre",
        "degree": 3,
        "n_steps": 3
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma86",
        "ipopt.ma57_pre_alloc": 1,
        "ipopt.max_cpu_time": 200,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
