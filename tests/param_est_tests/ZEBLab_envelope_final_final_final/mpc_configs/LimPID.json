{
    "model": {
        "ode": {
            "E": "pi_ode(E, ca.vertcat(ki,kp,Tmeas,Tset))"
        },
        "alg": {
            "_y": "_y - pi_y(E, ca.vertcat(ki,kp,Tmeas,Tset))[0]",
            "_kp": "_kp - pi_y(E, ca.vertcat(ki,kp,Tmeas,Tset))[1]",
            "_ki": "_ki - pi_y(E, ca.vertcat(ki,kp,Tmeas,Tset))[2]"
        },
        "p": [
        ],
        "u": [
            "ki",
            "kp",
            "Tmeas",
            "Tset"
        ],
        "z": [
            "_y",
            "_kp",
            "_ki"
        ],
        "r": [
        ],
        "x": [
            "E"
        ]
    },
    "bounds": {
        "u": {
            "lbu": [288.15,270.15],
            "ubu": [296.15,300.15]
        },
        "z": {
            "lbz": [0,0,0],
            "ubz": [1,1E6,1E6]
        }
    },
    "objective": "dot(_y, _y)",
    "N": 12,
    "dt": 60,
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.tol": 1E-8,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 3,
        "ipopt.ma57_automatic_scaling": "yes",
        "ipopt.max_cpu_time": 10,
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
