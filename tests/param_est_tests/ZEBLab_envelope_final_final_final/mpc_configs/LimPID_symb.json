{
    "model": {
        "ode": {
            "E": "(Tset - Ti)*(ki/kp)"
        },
        "alg": {
            "_y": "_y - kp*((Tset - Ti) + E)"
        },
        "w": {
            "v1": "_y - y1"
        },
        "p": [
            "kp",
            "ki"
        ],
        "u": [
            "Tset",
            "Ti"
        ],
        "z": [
            "_y"
        ],
        "x": [
            "E"
        ],
        "y": [
            ["y1", "_y"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [-1000],
            "ubx": [1000]
        },
        "z": {
            "lbz": [-1],
            "ubz": [1]
        }
    },
    "objective": "dot(_y, _y)",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.tol": 1E-8,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 3,
        "ipopt.ma57_automatic_scaling": "yes",
        "ipopt.max_cpu_time": 10,
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
