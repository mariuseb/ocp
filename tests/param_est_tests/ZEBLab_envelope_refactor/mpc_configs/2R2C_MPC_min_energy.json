{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*phi_h + Ai*(phi_s/Ci)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai"
        ],
        "u": [
        ],
        "r": [
            "Ta",
            "phi_h",
            "phi_s"
        ],
        "x": [
            "Ti",
            "Te"
        ]
    },
    "bounds": {
        "x": {
            "lbx": [280,280],
            "ubx": [340,340]
        }
    },
    "N": 96,
    "dt": 900,
    "objective": "ca.sum1(phi_h) + 1E3*dot(sl, sl)",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.max_iter" : 1E5
    },
    "codegen": false
}
