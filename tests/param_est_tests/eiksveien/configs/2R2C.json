{
    "model": {
        "ode": {
            "Ti": "(Tbedr - Ti)/(Rbi*Ci) + (Tfloor - Ti)/(Rfi*Ci) + (Ta - Ti)/(Ria*Ci)",
            "Tfloor": "(1/Cfloor)*phi_h + (Ti - Tfloor)/(Rfi*Cfloor)"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rbi",
            "Ci",
            "Cfloor",
            "Ria",
            "Rfi"
        ],
        "u": [
            "Tbedr", 
            "Ta",
            "phi_h"
        ],
        "x": [
            "Ti",
            "Tfloor"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
