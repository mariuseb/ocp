{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (Ta - Ti)/(Ria*Ci) + Ai*(phi_s/Ci) + rho_int*((int_con+int_lat+int_rad)/Ci) + (1/Ci)*alpha_vent1*cp_air*ahu_reaFloSupAir*(Tsup_air - Ti) + (Trad - Ti)/(Rirad*Ci)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "Trad": "Prad/Crad + (Ti - Trad)/(Rirad*Crad)",
            "Tret": "(rad_flo*a1*(dh_Tsup - Tret))/(Rrr*Cret)"
        },
        "alg": {
            "Prad": "Prad - rad_flo*cp_water*eta_hex_rad*(dh_Tsup - Tret)",
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_val, n1, 1E-6)"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rie",
            "Rea",
            "Ria",
            "Rirad",
            "rho_int",
            "Ci",
            "Ce",
            "Crad",
            "Ai",
            "cp_water",
            "cp_air",
            "alpha_vent1",
            "a1",
            "Cret",
            "Rrr",
            "dh_Tsup",
            "eta_hex_rad",
            "rad_flo_nom",
            "n1"
        ],
        "u": [
            "Pvent",
            "Prad",
            "ahu_pump_sup",
            "rad_flo",
            "ahu_reaFloSupAir",
            "Tsup",
            "rad_flo_on",
            "ahu_reaTHeaRec", 
            "Tsup_air",
            "rad_val"
        ],
        "r": [
            "Ta",
            "phi_s",
            "int_con",
            "int_lat",
            "int_rad"
        ],
        "x": [
            "Ti",
            "Te",
            "Trad",
            "Tret"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [280,280,280,280],
            "ubx": [340,340,340,340]
        }
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
