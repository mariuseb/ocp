{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie_TVP*Ci_TVP) + phi_h/Ci_TVP + Ai*(phi_s/Ci_TVP) + (1/Ci_TVP)*alpha_vent*cp_air*ahu_reaFloSupAir*(T_sup_air - Ti) + (1/Ci_TVP)*alpha_int*phi_int",
            "Te": "(Ti - Te)/(Rie_TVP*Ce_TVP) + (Ta - Te)/(Rea_TVP*Ce_TVP)"
        },
        "alg": {
            "Rie_TVP": "Rie + Rie_a*ca.if_else(V_sup_air > 10, 1, 0) - Rie_TVP",
            "Rea_TVP": "Rea + Rea_a*ca.if_else(V_sup_air > 10, 1, 0) - Rea_TVP",
            "Ci_TVP": "Ci + Ci_a*ca.if_else(V_sup_air > 10, 1, 0) - Ci_TVP",
            "Ce_TVP": "Ce + Ce_a*ca.if_else(V_sup_air > 10, 1, 0) - Ce_TVP"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rie",
            "Rie_a",
            "Rea",
            "Rea_a",
            "Ci",
            "Ci_a",
            "Ce",
            "Ce_a",
            "Ai",
            "Ae",
            "cp_air",
            "alpha_vent",
            "alpha_int",
            "R_121_e",
            "R_321_e",
            "R_320_e",
            "R_121_i",
            "R_321_i",
            "R_320_i"
        ],
        "u": [
            "phi_h",
            "phi_int",
            "phi_s",
            "Ta",
            "V_sup_air",
            "ahu_reaFloSupAir",
            "T_sup_air",
            "vent_on",
            "weeknd",
            "T_207",
            "T_121",
            "T_321",
            "T_320"
        ],
        "z": [
            "Rie_TVP",
            "Rea_TVP",
            "Ci_TVP",
            "Ce_TVP"
        ],
        "x": [
