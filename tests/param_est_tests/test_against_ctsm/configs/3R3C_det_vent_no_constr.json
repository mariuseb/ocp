{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (Th - Ti)/(Rih*Ci) + (Ta - Ti)/(Ria*Ci) + Ai*(phi_s/Ci) + (1/Ci)*alpha_vent*ahu_reaFloSupAir*cp_air*(T_sup_air - Ti)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "Th": "phi_h/Ch + (Ti - Th)/(Rih*Ch)"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rie",
            "Rea",
            "Ria",
            "Ci",
            "Ce",
            "Ai",
            "Ae",
            "Rih",
            "Ch",
            "cp_air",
            "alpha_vent"
        ],
        "u": [
            "phi_h",
            "phi_s",
            "Ta",
            "V_sup_air",
            "ahu_reaFloSupAir",
            "T_sup_air"
        ],
        "x": [
            "Ti",
            "Te",
            "Th"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(s1, s1)@Q[0,0] + dot(s2, s2)@Q[1,1] + dot(s3, s3)@Q[2,2]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": true
}
