{
    "model": {
        "ode": {
            "rad_flo": "(rad_flo_set - rad_flo)/tau"
        },
        "alg": {
            "rad_flo_set": "rad_flo_set - rad_flo_nom*regNonZeroPower(rad_val, n, 1E-6)",
        },
        "w": {
            "v1": "y1 - rad_flo"
        },
        "p": [
            "n",
            "rad_flo_nom",
            "tau"
        ],
        "u": [
            "rad_val",
        ],
        "r": [
        ],
        "x": [
            "rad_flo"
        ],
        "z": [
          "rad_flo"
        ],
        "y": [
            ["y1", "rad_flo"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [-0.05],
            "ubx": [0.15]
        },
        "z": {
            "lbz": [-0.05],
            "ubz": [0.15]
        }
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 5000,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
