{
    "model": {
        "ode": {
            "rad_flo": "(rad_flo_set - rad_flo)/tau",
            "Tret": "(a1*rad_val*(Trad - Tret))/(Rrr*Cret) + (1 - rad_val)*(Ti - Tret)/(Riret*Cret)",
            "Trad": "rad_val*cp_water*(dh_Tsup - Trad_offset - Trad)/Crad + (Ti - Trad)/(Rirad*Crad)"
        },
        "alg": {
            "rad_flo_set": "rad_flo_set - rad_flo_nom*regNonZeroPower(rad_val, n, 1E-6)",
            "Prad": "Prad - (dh_Tsup - Tret)*cp_water*rad_flo"
        },
        "w": {
            "v1": "y1 - rad_flo",
            "v2": "y2 - Prad",
            "v3": "y3 - Tret"
        },
        "p": [
            "n",
            "rad_flo_nom",
            "tau", 
            "dTnom",
            "cp_water",
            "dh_Tsup",
            "dh_Tsup_off",
            "Csup",
            "Rsup",
            "Riret",
            "Cret",
            "Rrr",
            "a1",
            "Rirad",
            "Crad",
            "Trad_offset"
        ],
        "u": [
            "rad_val",
            "m_flow_bool",
            "Ti"
        ],
        "r": [
        ],
        "x": [
            "rad_flo",
            "Tret",
            "Trad"
        ],
        "z": [
          "rad_flo_set",
          "Prad"
        ],
        "y": [
            ["y1", "rad_flo"],
            ["y2", "Prad"],
            ["y3", "Tret"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [-0.05,290,290],
            "ubx": [0.15,315,315]
        },
        "z": {
            "lbz": [-0.05,-1000],
            "ubz": [0.15,10000]
        }
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(v2, v2)@R[1,1] + dot(m_flow_bool*v3, m_flow_bool*v3)@R[2,2]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 5000,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
