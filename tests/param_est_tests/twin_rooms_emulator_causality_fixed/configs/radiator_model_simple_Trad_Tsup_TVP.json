{
    "model": {
        "ode": {
            "Tret": "Prad/Cret + (Ti - Tret)/(Riret*Cret)",
            "Tsup": "m_flow_bool*(Tset_sup - Tsup)/(Rsup*Csup) + m_flow_bool*(Ti + Tsup_offset - Tsup)/(Rsup_off*Csup_off)"
        },
        "alg": {
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_val, n, 1E-6)",
            "Prad": "Prad - (Tsup - Tret)*cp_water*rad_flo",
            "Tset_sup": "Tset_sup - (Tset_sup_b - Tset_sup_a*(Ta - Ta_dim))"
        },
        "w": {
            "v1": "y1 - rad_flo",
            "v2": "y2 - Prad",
            "v3": "y3 - Tret",
            "v4": "y4 - Tsup"
        },
        "p": [
            "n",
            "rad_flo_nom",
            "cp_water",
            "Csup",
            "Rsup",
            "Csup_off",
            "Rsup_off",
            "Riret",
            "Risup",
            "Cret",
            "Tsup_offset",
            "Tset_sup_b",
            "Tset_sup_a",
            "Ta_dim"
        ],
        "u": [
            "rad_val",
            "m_flow_bool",
            "Ti",
            "Ta"
        ],
        "r": [
        ],
        "x": [
            "Tret",
            "Tsup"
        ],
        "z": [
          "rad_flo",
          "Prad",
          "Tset_sup"
        ],
        "y": [
            ["y1", "rad_flo"],
            ["y2", "Prad"],
            ["y3", "Tret"],
            ["y4", "Tsup"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [290,290],
            "ubx": [330,330]
        },
        "z": {
            "lbz": [-0.05,-1000,290],
            "ubz": [0.15,10000,330]
        }
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(v2, v2)@R[1,1] + dot(m_flow_bool*v3, m_flow_bool*v3)@R[2,2]+ dot(m_flow_bool*v4, m_flow_bool*v4)@R[3,3]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 5000,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
