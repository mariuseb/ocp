{
    "model": {
        "ode": {
            "Trad": "P_to_rad/Crad - P_to_env/Crad",
            "Tret": "P_to_ret/Cret + (Ti - Tret)/(Riret*Cret)",
            "Tsup": "rad_val*(Tset_sup - Tsup)/(Rsup*Csup) - P_to_rad/Csup - P_to_ret/Csup + (1 - rad_val)*(Ti + Tsup_offset - Tsup)/(Risup*Csup)"
        },
        "alg": {
            "rad_flo": "rad_flo - rad_flo_nom*regNonZeroPower(rad_val, n, 1E-6)",
            "Tset_sup": "Tset_sup - (Tset_sup_b - Tset_sup_a*(Ta - Ta_dim))",
            "Prad": "Prad - (Tsup - Tret)*cp_water*rad_flo",
            "P_to_rad": "P_to_rad - rad_flo*cp_water*(Tsup - Trad)",
            "P_to_env": "P_to_env - (Trad - Ti)/Rirad",
            "P_to_ret": "P_to_ret - rad_flo*cp_water*(Trad + Trad_offset - Tret)"
        },
        "w": {
            "v1": "y1 - rad_flo",
            "v2": "y2 - Prad",
            "v3": "y3 - Tret",
            "v4": "y4 - Tsup"
        },
        "p": [
            "n",
            "rad_flo_nom",
            "tau", 
            "dTnom",
            "cp_water",
            "dh_Tsup",
            "Csup",
            "Rsup",
            "Riret",
            "Risup",
            "Cret",
            "Rrr",
            "Rirad",
            "Crad",
            "Tsup_offset",
            "Trad_offset",
            "Tset_sup_b",
            "Tset_sup_a",
            "Ta_dim"
        ],
        "u": [
            "rad_val",
            "m_flow_bool",
            "Ti",
            "Ta"
        ],
        "r": [
        ],
        "x": [
            "Trad",
            "Tret",
            "Tsup"
        ],
        "z": [
          "rad_flo",
          "Tset_sup",
          "Prad",
          "P_to_rad",
          "P_to_env",
          "P_to_ret"
        ],
        "y": [
            ["y1", "rad_flo"],
            ["y2", "Prad"],
            ["y3", "Tret"],
            ["y4", "Tsup"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [290,290,290],
            "ubx": [330,330,330]
        },
        "z": {
            "lbz": [-0.05,-1000,290,-10000,-10000,-10000],
            "ubz": [0.15,10000,330,10000,10000,10000]
        }
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(v2, v2)@R[1,1] + dot(m_flow_bool*v3, m_flow_bool*v3)@R[2,2]+ dot(m_flow_bool*v4, m_flow_bool*v4)@R[3,3]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 5000,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
