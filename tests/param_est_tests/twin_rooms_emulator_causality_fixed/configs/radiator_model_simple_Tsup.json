{
    "model": {
        "ode": {
            "rad_flo": "(rad_flo_set - rad_flo)/tau",
            "Tsup": "(a1*rad_val*(dh_Tsup - Tsup))/(Rsup*Csup) + rad_val*(Ti - Tsup)/(Risup*Csup) + ((1 - rad_val)*(dh_Tsup_off - Tsup))/(Rsup*Csup)"
        },
        "alg": {
            "rad_flo_set": "rad_flo_set - rad_flo_nom*regNonZeroPower(rad_val, n, 1E-6)",
            "Prad": "Prad - (Tsup - Tret)*cp_water*rad_flo"
        },
        "w": {
            "v1": "y1 - rad_flo",
            "v2": "y2 - Prad",
            "v3": "y3 - Tsup"
        },
        "p": [
            "n",
            "rad_flo_nom",
            "tau", 
            "dTnom",
            "cp_water",
            "dh_Tsup",
            "dh_Tsup_off",
            "Csup",
            "Rsup",
            "Risup",
            "Csup_off",
            "Rsup_off",
            "a1"
        ],
        "u": [
            "rad_val",
            "m_flow_bool",
            "Ti",
            "Tret"
        ],
        "r": [
        ],
        "x": [
            "rad_flo",
            "Tsup"
        ],
        "z": [
          "rad_flo_set",
          "Prad"
        ],
        "y": [
            ["y1", "rad_flo"],
            ["y2", "Prad"],
            ["y3", "Tsup"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [-0.05,200],
            "ubx": [0.15,400]
        },
        "z": {
            "lbz": [-0.05,-1000],
            "ubz": [0.15,10000]
        }
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(v2, v2)@R[1,1] + dot(m_flow_bool*v3, m_flow_bool*v3)@R[2,2]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 5000,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
