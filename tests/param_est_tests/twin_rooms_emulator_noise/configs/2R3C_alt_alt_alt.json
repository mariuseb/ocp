{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*Prad + Ai*(phi_s/Ci)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "dT": "(rad_flo/rad_flo_nom)*(dTdim - dT)/tau + (1 - (rad_flo/rad_flo_nom))*(dTpeak - dT)/tau",
            "rad_flo": "(rad_flo_set - rad_flo)/tau_flow"
        },
        "alg": {
            "rad_flo_set": "rad_flo_set - rad_flo_nom*regNonZeroPower(rad_219, n, 1E-6)",
            "Prad": "Prad - dT*rad_219*rad_flo*cp_water",
            "dTdim": "dTdim - (dT_b - dT_a*(Ta - Ta_dim))",
            "dTpeak": "dTpeak - (dTpeak_b - dTpeak_a*(Ta - Ta_dim))"
        },
        "w": {
            "v1": "Ti - y1",
            "v2": "Prad - y3"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "dT_b",
            "dT_a",
            "Ta_dim", 
            "rad_flo_nom",
            "dTpeak_b",
            "dTpeak_a",
            "tau", 
            "tau_flow", 
            "n", 
            "cp_water"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
            "Ta",
            "phi_s",
            "m_flow_bool"
        ],
        "x": [
            "Ti",
            "Te",
            "dT",
            "rad_flo"
        ],
        "z": [
            "rad_flo_set",
            "Prad",
            "dTdim",
            "dTpeak"
        ],
        "y": [
            ["y1", "Ti"],
            ["y3", "Prad"]
        ]
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(v2, v2)@R[1,1]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 30000,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
