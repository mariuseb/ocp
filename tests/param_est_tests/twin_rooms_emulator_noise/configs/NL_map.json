{
    "model": {
        "ode": {
            "Prad": "(Prad_set - Prad)/tau"
        },
        "alg": {
            "Prad_set": "Prad_set - Prad_nom*regNonZeroPower(rad_219, n, 1E-6)"
        },
        "w": {
            "v1": "y3 - Prad"
        },
        "p": [
            "n",
            "Prad_nom",
            "tau"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
        ],
        "x": [
            "Prad"
        ],
        "z": [
          "Prad_set"
        ],
        "y": [
            ["y3", "Prad"]

        ]
    },
    "bounds": {
        "z": {
            "lbz": [-1000],
            "ubz": [1E4]
        },
        "x": {
            "lbx": [-1000],
            "ubx": [1E4]
        }
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.max_iter" : 1E5
    },
    "codegen": false
}
