{
    "model": {
        "ode": {
            "rad_flo": "(rad_flo_set - rad_flo)/tau"
        },
        "alg": {
            "rad_flo_set": "rad_flo_set - rad_flo_nom*regNonZeroPower(rad_219, n, 1E-6)",
            "Prad": "Prad - dT_nom*cp_water*rad_flo"
        },
        "w": {
            "v2": "y2 - rad_flo",
            "v3": "y3 - Prad"
        },
        "p": [
            "n",
            "dT_nom",
            "rad_flo_nom",
            "cp_water",
            "tau"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
        ],
        "x": [
            "rad_flo"
        ],
        "z": [
          "rad_flo_set",
          "Prad"
        ],
        "y": [
            ["y2", "rad_flo"],
            ["y3", "Prad"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [0],
            "ubx": [0.15]
        },
        "z": {
            "lbz": [0,0],
            "ubz": [0.15,1E4]
        }
    },
    "objective": "dot(v2, v2)@R[0,0] + dot(v3, v3)@R[1,1]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 5000,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
