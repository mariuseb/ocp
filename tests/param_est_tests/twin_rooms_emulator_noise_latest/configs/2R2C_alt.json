{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*Prad + Ai*(phi_s/Ci)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)"
        },
        "alg": {
            "Prad": "Prad - Prad_dim*rad_219",
            "Prad_dim": "Prad_dim - (Prad_b - Prad_a*(Ta - Ta_dim))"
        },
        "w": {
            "v1": "Ti - y1",
            "v2": "Prad - y3"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "Prad_b",
            "Prad_a",
            "Ta_dim"
        ],
        "u": [
            "rad_219"
        ],
        "r": [
            "Ta",
            "phi_s",
            "m_flow_bool"
        ],
        "x": [
            "Ti",
            "Te"
        ],
        "z": [
            "Prad",
            "Prad_dim"
        ],
        "y": [
            ["y1", "Ti"],
            ["y3", "Prad"]
        ]
    },
    "objective": "dot(v1, v1)@R[0,0] + dot(v2, v2)@R[1,1]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.max_iter": 30000,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
