{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (Ta - Ti)/(Ria*Ci) + Ai*(phi_s/Ci) + Prad_to_env/Ci",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)",
            "Trad": "Prad/Crad - Prad_to_env/Crad"
        },
        "alg": {
            "Prad_to_env": "Prad_to_env - (Trad - Ti)/Rirad"
        },
        "w": {
            "v1": "y1 - Ti"
        },
        "p": [
            "Rie",
            "Rea",
            "Ria",
            "Rirad",
            "Crad",
            "Ci",
            "Ce",
            "Ai"
        ],
        "u": [
            "Prad"
        ],
        "r": [
            "Ta",
            "phi_s",
            "m_flow_bool"
        ],
        "x": [
            "Ti",
            "Te",
            "Trad"
        ],
        "z": [
          "Prad_to_env"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [280,280,280],
            "ubx": [340,340,340]
        },
        "z": {
            "lbz": [0],
            "ubz": [1E4]
        }
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.max_iter" : 1E5
    },
    "codegen": false
}
