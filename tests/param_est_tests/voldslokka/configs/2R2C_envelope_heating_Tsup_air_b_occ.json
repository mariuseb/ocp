{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ci)*phi_int_base*alpha_int*b_occ + Ai*(phi_s/Ci) + alpha_vent*(1/Ci)*phi_v",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce) + (1/Ce)*phi_h"
        },
        "alg": {
            "phi_v": "phi_v - m_flow_air*1005*(Tsup_air - Ti)"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "alpha_int",
            "alpha_vent",
            "phi_int_base"
        ],
        "u": [
            "Ta",
            "Tsup_air",
            "m_flow_air",
            "phi_h",
            "phi_s",
            "b_occ"
        ],
        "x": [
            "Ti",
            "Te"
        ],
        "z": [
            "phi_v"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 1.05,
        "ipopt.max_iter": 30000,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
