{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie*Ci) + (1/Ce)*u_val*Prad_nom + Ai*(phi_s/Ci) + alpha_vent*Vsup_air*cp_air*(Tsup_air - Ti)*cp_air*(1/Ci) + Pint_nom*occ*(1/Ci)",
            "Te": "(Ti - Te)/(Rie*Ce) + (Ta - Te)/(Rea*Ce)"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rie",
            "Rea",
            "Ci",
            "Ce",
            "Ai",
            "cp_air",
            "Prad_nom", 
            "Pint_nom",
            "alpha_vent"
        ],
        "u": [
            "Ta",
            "Tsup_air",
            "Vsup_air",
            "u_val",
            "phi_s",
            "occ"
        ],
        "x": [
            "Ti",
            "Te"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 1,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 1.05,
        "ipopt.max_iter": 30000,
        "ipopt.ma57_automatic_scaling" : "yes",
        "ipopt.hessian_approximation": "exact"
    },
    "codegen": false
}
