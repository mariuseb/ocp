{
    "model": {
        "ode": {
            "CO2_in": "c*n_mech*(CO2_out - CO2_in) + c_occ*n_occ*b_occ"
        },
        "w": {
            "v1": "CO2_in - y1"
        },
        "p": [
            "c",
            "CO2_out",
            "n_inf",
            "c_occ"
        ],
        "u": [
            "n_mech",
            "b_occ"
        ],
        "r": [
            "n_occ"
        ],
        "x": [
            "CO2_in"
        ],
        "y": [
            ["y1", "CO2_in"]
        ]
    },
    "bounds": {
        "x": {
            "lbx": [0],
            "ubx": [1000]
        }
    },
    "ocp": {
        "h": 
        [
            "0 <= n_occ"        
        ]
    },
    "objective": "dot(v1, v1)@R[0,0] + 1E-5*dot(n_occ, n_occ) + dot(s1, s1)@Q[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "radau",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "none",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
