{
    "model": {
        "ode": {
            "Ti": "(Te - Ti)/(Rie_TVP*Ci_TVP) + (1/Ci_TVP)*phi_h + Ai*(phi_s/Ci_TVP) + (1/Ci_TVP)*alpha_vent_sup*ahu_reaFloSupAir*(T_sup_air - Ti) + (1/Ci_TVP)*alpha_vent_ext*ahu_reaFloExtAir*(Ti - T_ext_air) + (1/Ci_TVP)*alpha_int_plugs*phi_int_plugs + (1/Ci_TVP)*alpha_int_lig*phi_int_lig",
            "Te": "(Ti - Te)/(Rie_TVP*Ce_TVP) + (Ta - Te)/(Rea_TVP*Ce_TVP)"
        },
        "alg": {
            "Rie_TVP": "stepQi*Rie_w + (1 - stepQi - vent)*Rie + vent*Rie_v - Rie_TVP",
            "Rea_TVP": "stepQi*Rea_w + (1 - stepQi - vent)*Rea + vent*Rea_v - Rea_TVP",
            "Ci_TVP": "stepQi*Ci_w + (1 - stepQi - vent)*Ci + vent*Ci_v - Ci_TVP",
            "Ce_TVP": "stepQi*Ce_w + (1 - stepQi - vent)*Ce + vent*Ce_v - Ce_TVP"
        },
        "w": {
            "v1": "Ti - y1"
        },
        "p": [
            "Rie",
            "Rie_w",
            "Rie_v",
            "Rea",
            "Rea_w",
            "Rea_v",
            "Ci",
            "Ci_w",
            "Ci_v",
            "Ce",
            "Ce_w",
            "Ce_v",
            "Ai",
            "alpha_vent_sup",
            "alpha_vent_ext",
            "alpha_int_plugs",
            "alpha_int_lig"
        ],
        "u": [
            "Ta",
            "T_sup_air",
            "T_ext_air",
            "T_207",
            "T_121",
            "T_321",
            "T_320",
            "phi_h",
            "phi_int_plugs",
            "phi_int_lig",
            "phi_s",
            "ahu_reaFloSupAir",
            "ahu_reaFloExtAir",
            "weeknd",
            "vent",
            "stepQi"
        ],
        "z": [
            "Rie_TVP",
            "Rea_TVP",
            "Ci_TVP",
            "Ce_TVP"
        ],
        "x": [
            "Ti",
            "Te"
        ],
        "y": [
            ["y1", "Ti"]
        ]
    },
    "bounds": {
        "z": {
            "lbz": [1E-5,1E-5,1E5,1E5],
            "ubz": [1,1,1E9,1E9]
        }
    },
    "objective": "dot(v1, v1)@R[0,0]",
    "method": "multiple_shooting",
    "integrator": 
        {
        "name": "IRK",
        "method": "legendre",
        "degree": 3,
        "n_steps": 1
        }
    ,
    "solver": "",
    "opt": {
        "verbose": false,
        "ipopt.linear_solver": "ma57",
        "ipopt.ma57_pre_alloc": 10,
        "ipopt.ma57_automatic_scaling" : "yes"
    },
    "codegen": false
}
